{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/node_modules", "!**/.next", "!**/.turbo", "!**/dist", "!**/build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "domains": {
          "next": "recommended",
          "react": "recommended"
        }
      }
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "react-dom": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "next": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "three": "Packages must be renderer-agnostic (ADR-0008, ADR-0011)."
                },
                "patterns": [
                  {
                    "group": ["react/*", "react-dom/*", "next/*", "three/*", "@react-three/*"],
                    "message": "Packages must be framework- and renderer-agnostic (ADR-0011)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
