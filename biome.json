{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/dist",
      "!**/build",
      "!**/fixtures/**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**", "apps/desktop/**"],
      "linter": {
        "domains": {
          "next": "recommended",
          "react": "recommended"
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/app/**",
        "!apps/web/src/components/**",
        "!apps/web/src/hooks/**",
        "!apps/web/src/lib/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**", "../**/app", "../**/app/**"],
                    "message": "Only route files live in app/; import the feature instead (ADR-0021)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/**", "apps/web/src/hooks/**", "apps/web/src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**", "../**/app", "../**/app/**"],
                    "message": "Only route files live in app/; import the feature instead (ADR-0021)."
                  },
                  {
                    "group": ["@/features", "@/features/**", "../**/features", "../**/features/**"],
                    "message": "Shared code must not depend on features; move it into the feature (ADR-0021)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/document/**", "packages/cam-core/**", "packages/post/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "react-dom": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "next": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "three": "Packages must be renderer-agnostic (ADR-0008, ADR-0011).",
                  "clipper2-ts": "Only the geometry adapter may import the kernel (ADR-0007, ADR-0015).",
                  "delaunator": "Only the medial-axis adapter may import Delaunator (ADR-0025)."
                },
                "patterns": [
                  {
                    "group": ["react/*", "react-dom/*", "next/*", "three/*", "@react-three/*"],
                    "message": "Packages must be framework- and renderer-agnostic (ADR-0011)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/**", "packages/workspace/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        },
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next": "UI packages must not depend on Next.js, so the desktop app can use them (ADR-0046)."
                },
                "patterns": [
                  {
                    "group": ["next/*", "@next/*"],
                    "message": "UI packages must not depend on Next.js, so the desktop app can use them (ADR-0046)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/workspace/src/workers/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Workers import only core packages and plain modules (ADR-0004, ADR-0046).",
                  "react-dom": "Workers import only core packages and plain modules (ADR-0004, ADR-0046).",
                  "next": "Workers import only core packages and plain modules (ADR-0004, ADR-0046).",
                  "three": "Workers import only core packages and plain modules (ADR-0004, ADR-0046).",
                  "zustand": "Workers import only core packages and plain modules (ADR-0004, ADR-0046).",
                  "immer": "Workers import only core packages and plain modules (ADR-0004, ADR-0046)."
                },
                "patterns": [
                  {
                    "group": [
                      "react/*",
                      "react-dom/*",
                      "next/*",
                      "three/*",
                      "@react-three/*",
                      "@furrow/ui",
                      "@furrow/ui/**",
                      "../components/**",
                      "../providers/**",
                      "../hooks/**",
                      "../tools/**",
                      "../onboarding/**"
                    ],
                    "message": "Workers import only core packages and plain modules (ADR-0004, ADR-0046)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cam-core/src/geometry/clipper.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "react-dom": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "next": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "three": "Packages must be renderer-agnostic (ADR-0008, ADR-0011).",
                  "delaunator": "Only the medial-axis adapter may import Delaunator (ADR-0025)."
                },
                "patterns": [
                  {
                    "group": ["react/*", "react-dom/*", "next/*", "three/*", "@react-three/*"],
                    "message": "Packages must be framework- and renderer-agnostic (ADR-0011)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cam-core/src/geometry/medial-axis.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "react-dom": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "next": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "three": "Packages must be renderer-agnostic (ADR-0008, ADR-0011).",
                  "clipper2-ts": "Only the geometry adapter may import the kernel (ADR-0007, ADR-0015)."
                },
                "patterns": [
                  {
                    "group": ["react/*", "react-dom/*", "next/*", "three/*", "@react-three/*"],
                    "message": "Packages must be framework- and renderer-agnostic (ADR-0011)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
