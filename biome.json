{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/dist",
      "!**/build",
      "!**/fixtures/**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "domains": {
          "next": "recommended",
          "react": "recommended"
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/app/**",
        "!apps/web/src/components/**",
        "!apps/web/src/hooks/**",
        "!apps/web/src/lib/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "Only route files live in app/; import the feature instead (ADR-0021)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/**", "apps/web/src/hooks/**", "apps/web/src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "Only route files live in app/; import the feature instead (ADR-0021)."
                  },
                  {
                    "group": ["@/features", "@/features/**"],
                    "message": "Shared code must not depend on features; move it into the feature (ADR-0021)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "react-dom": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "next": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "three": "Packages must be renderer-agnostic (ADR-0008, ADR-0011).",
                  "clipper2-ts": "Only the geometry adapter may import the kernel (ADR-0007, ADR-0015)."
                },
                "patterns": [
                  {
                    "group": ["react/*", "react-dom/*", "next/*", "three/*", "@react-three/*"],
                    "message": "Packages must be framework- and renderer-agnostic (ADR-0011)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cam-core/src/geometry.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "react-dom": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "next": "Packages must be framework-agnostic (ADR-0002, ADR-0011).",
                  "three": "Packages must be renderer-agnostic (ADR-0008, ADR-0011)."
                },
                "patterns": [
                  {
                    "group": ["react/*", "react-dom/*", "next/*", "three/*", "@react-three/*"],
                    "message": "Packages must be framework- and renderer-agnostic (ADR-0011)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
