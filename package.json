{
  "name": "furrow-cam",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "email:dev": "pnpm --filter @furrow/web email:dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "biome check",
    "check:fix": "biome check --write",
    "check:ci": "biome ci",
    "db:up": "docker compose up -d --wait && pnpm storage:init",
    "db:migrate": "pnpm --filter @furrow/web db:migrate",
    "db:studio": "pnpm --filter @furrow/web db:studio",
    "storage:init": "pnpm --filter @furrow/web storage:init",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0"
}
