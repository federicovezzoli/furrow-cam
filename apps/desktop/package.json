    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.7",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "lucide-react": "^1.52.0",
    "next-themes": "^0.4.6",
    "posthog-node": "^5.56.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
