{
  "name": "@furrow/mcp",
  "version": "0.0.0",
  "description": "Furrow CAM's local MCP server: AI assistants work on .furrow projects over stdio (PRD-0012, ADR-0067)",
  "license": "MIT",
  "homepage": "https://github.com/federicovezzoli/furrow-cam/tree/main/apps/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/federicovezzoli/furrow-cam.git",
    "directory": "apps/mcp"
  },
  "type": "module",
  "bin": {
    "furrow-mcp": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --define:process.env.NODE_ENV='\"production\"' --banner:js='#!/usr/bin/env node' --outfile=dist/main.js",
    "prepack": "pnpm run build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@furrow/cam-core": "workspace:*",
    "@furrow/document": "workspace:*",
    "@furrow/ui": "workspace:*",
    "@furrow/workspace": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
