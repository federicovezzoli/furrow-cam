# Copy to .env and adjust. Local values match docker-compose.yml.

# PostgreSQL. In production use Neon's pooled connection string (ADR-0005).
DATABASE_URL="postgresql://furrow:furrow@localhost:5432/furrow"
# Optional: direct (non-pooled) connection for Prisma migrations, e.g. on Neon.
DIRECT_URL=""

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend. When unset outside production, emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Furrow CAM <noreply@example.com>"

# GoatCounter page-view analytics (ADR-0020), e.g. https://<code>.goatcounter.com/count.
# Leave empty in development: nothing is loaded or counted when unset.
NEXT_PUBLIC_GOATCOUNTER_URL=""

# S3-compatible storage for STL meshes (ADR-0029): Cloudflare R2, AWS S3, Backblaze B2, …
# Leave the bucket and keys empty to turn STL import off. The local values match docker-compose.yml;
# `pnpm db:up` creates the bucket and lets the app at BETTER_AUTH_URL upload to it (CORS). Run
# `pnpm storage:init` with the production values to do the same for a new bucket.
# On R2 the endpoint is https://<account id>.r2.cloudflarestorage.com, or
# https://<account id>.eu.r2.cloudflarestorage.com for an EU-jurisdiction bucket (the public
# instance); leave it empty for AWS S3.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="furrow"
S3_ACCESS_KEY_ID="furrow"
S3_SECRET_ACCESS_KEY="furrow-secret"
# Largest STL file accepted, in megabytes (default 50).
STL_MAX_FILE_MB=""
