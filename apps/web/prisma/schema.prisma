// Auth models (User, Session, Account, Verification) are generated by Better Auth:
//   pnpm dlx auth@<better-auth version> generate --config src/features/auth/auth.ts
// Edit them only through Better Auth options, then regenerate (ADR-0006).

generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id
  name                String
  email               String
  emailVerified       Boolean   @default(false)
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  appTourDoneAt       DateTime?
  workspaceTourDoneAt DateTime?
  sessions            Session[]
  accounts            Account[]
  tools               Tool[]
  machines            Machine[]
  projects            Project[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Mirrors the `Tool` schema in @furrow/document (#10): rows are validated with it
// on write and snapshotted into operations with `Tool.parse(row)` (ADR-0003).
// Lengths in mm, feeds in mm/min.

enum ToolType {
  flat_end_mill
  ball_end_mill
  tapered_ball_end_mill
  v_bit
  drill
}

enum CutDirection {
  upcut
  downcut
  compression
}

model Tool {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         ToolType
  diameter     Float
  fluteCount   Int
  fluteLength  Float
  cutDirection CutDirection?
  vAngle       Float?
  tipDiameter  Float?
  /// Tapered ball end mills' angle per side, in degrees.
  taperAngle   Float?
  spindleRpm   Int
  feedRate     Float
  plungeRate   Float
  /// Degrees from horizontal; 90 plunges straight down (see `Tool` in @furrow/document).
  plungeAngle  Float
  stepDown     Float
  notes        String?
  color        String
  /// The tool preselected for new operations; at most one per user.
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId], where: raw("\"isDefault\""), map: "tool_userId_default_key")
  @@index([userId])
  @@map("tool")
}

// Mirrors the `Machine` schema in @furrow/document (#11): rows are validated with it
// on write and snapshotted into projects with `Machine.parse(row)` (ADR-0003).
// Lengths in mm, feeds in mm/min.

enum PostProcessor {
  grbl
}

model Machine {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  workAreaX      Float
  workAreaY      Float
  workAreaZ      Float
  maxFeedXY      Float
  maxFeedZ       Float
  /// Both `NULL` for a manual spindle: the post-processor omits the `S` word.
  spindleRpmMin  Int?
  spindleRpmMax  Int?
  /// Seconds to wait after starting the spindle or raising its speed.
  spinUpDelay    Float
  safeZ          Float
  /// Height above the stock where rapids down stop and feeding starts, at most `safeZ`.
  entryClearance Float
  postProcessor  PostProcessor
  /// Custom G-code replacing the post-processor's default at that point; `NULL` keeps the default.
  programStart   String?
  programEnd     String?
  operationStart String?
  toolChange     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@map("machine")
}

// Project metadata is relational; the contents are one versioned JSON document,
// validated with `ProjectDocument` from @furrow/document on every write (ADR-0003).

model Project {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  /// Copy of `document.schemaVersion`, so stale documents can be found without reading them.
  schemaVersion Int
  /// Copy of `document.machine.name`, so the project list can show it without reading documents.
  machineName   String?
  document      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  versions      ProjectVersion[]
  assets        ProjectAsset[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("project")
}

/// A saved copy of a project's document (ADR-0028), restorable later.
model ProjectVersion {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// `null` for an unlabelled version, shown by its date.
  label         String?
  /// Copy of `document.schemaVersion`, as on `Project`.
  schemaVersion Int
  document      Json
  createdAt     DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@map("project_version")
}

/// A file stored outside the document, in S3-compatible storage (ADR-0029): an STL mesh or an uploaded font (ADR-0062).
/// The object key is `<userId>/<projectId>/<sha256>`. Kept as long as the project, so its
/// versions can reference it too.
model ProjectAsset {
  id         String    @id @default(uuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// SHA-256 of the file's bytes, in lowercase hex, as documents reference it.
  sha256     String
  /// In bytes.
  size       Int
  /// When the stored object was checked against `sha256` and `size`; until then, documents can't use it.
  verifiedAt DateTime?
  /// Until verified, refreshed on each upload request: the storage sweep deletes unverified assets a day old.
  createdAt  DateTime  @default(now())

  @@unique([projectId, sha256])
  @@map("project_asset")
}

// Better Auth's rate-limit counters (#274), shared by every server instance. `key` is the
// client IP plus the endpoint path; no other personal data (ADR-0013).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit") // Better Auth checks for this table name
}
